# Local development only. Matches compose.yaml; never expose this database publicly.
DATABASE_URL=postgresql://flashpoint:flashpoint_local@127.0.0.1:5432/flashpoint

# Optional absolute path for originals. Defaults to .data/uploads in this project.
# UPLOAD_DIR=/absolute/path/to/flashpoint-uploads

# Required only for AI preference extraction. Keep the key server-side.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4-mini
